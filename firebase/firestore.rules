rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function workspacePath(w) { return /databases/$(database)/documents/workspaces/$(w); }
    function memberPath(w) { return /databases/$(database)/documents/workspaces/$(w)/members/$(request.auth.uid); }
    function member(w) { return signedIn() && exists(memberPath(w)); }
    function owner(w) { return signedIn() && get(workspacePath(w)).data.ownerID == request.auth.uid; }
    function recentLogin() { return signedIn() && request.auth.token.get('auth_time', 0) is int
      && request.time.toMillis() - request.auth.token.get('auth_time', 0) * 1000 >= 0
      && request.time.toMillis() - request.auth.token.get('auth_time', 0) * 1000 < 300000; }
    function unlocked(w) { return !('deletingBy' in get(workspacePath(w)).data); }
    function accountActive() { return signedIn() && (!exists(userPath()) || get(userPath()).data.get('deletingAccount', false) != true); }
    function canWrite(w) { return member(w) && unlocked(w) && accountActive(); }
    function purging(w) { return owner(w) && recentLogin() && get(workspacePath(w)).data.get('deletingBy', '') == request.auth.uid; }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    // Old documents have no category; explicit values must use stable catalogue IDs.
    function validCategory(data) {
      return !('category' in data) || (data.category is string && data.category in [
        'produce', 'dairy', 'meat', 'fish', 'bakery', 'pantry',
        'frozen', 'drinks', 'snacks', 'household', 'hygiene', 'other'
      ]);
    }
    function validIdentity(data) { return !('displayName' in data) || text(data.displayName,160); }
    function unassigned() { return !exists(userPath()); }
    function validInvite(w, token) {
      let invite = get(/databases/$(database)/documents/invites/$(token));
      return unlocked(w) && invite.data.workspaceID == w && invite.data.expiresAt > request.time
        && get(workspacePath(w)).data.inviteToken == token;
    }
    match /users/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && uid == request.auth.uid && ((accountActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastViewedListID'])
        && request.resource.data.lastViewedListID is string
        && member(resource.data.workspaceID)
        && existsAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceID)/lists/$(request.resource.data.lastViewedListID)))
        || (recentLogin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletingAccount'])
          && (!('deletingAccount' in request.resource.data) || request.resource.data.deletingAccount == true)));
      match /devices/{installation} {
        allow read, delete: if signedIn() && uid == request.auth.uid;
        allow create, update: if signedIn() && uid == request.auth.uid && accountActive()
          && installation.size() >= 10 && installation.size() <= 128
          && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
          && text(request.resource.data.token,4096) && request.resource.data.token.size() >= 20
          && request.resource.data.platform == 'ios' && request.resource.data.updatedAt == request.time;
      }
      allow delete: if signedIn() && uid == request.auth.uid && recentLogin()
        && !existsAfter(memberPath(resource.data.workspaceID));
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['workspaceID','lastViewedListID'])
        && (!('lastViewedListID' in request.resource.data) || (request.resource.data.lastViewedListID is string
          && existsAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceID)/lists/$(request.resource.data.lastViewedListID))))
        && request.resource.data.workspaceID is string
        && existsAfter(memberPath(request.resource.data.workspaceID));
    }
    match /workspaces/{w} {
      allow get: if member(w);
      allow create: if signedIn() && unassigned()
        && request.resource.data.keys().hasOnly(['name', 'ownerID'])
        && text(request.resource.data.name, 80)
        && request.resource.data.ownerID == request.auth.uid
        && getAfter(userPath()).data.workspaceID == w
        && getAfter(memberPath(w)).data.role == 'owner';
      allow update: if owner(w) && (
        (unlocked(w) && accountActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteToken']))
        || (recentLogin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletingBy','inviteToken'])
          && request.resource.data.get('deletingBy','') == request.auth.uid && !('inviteToken' in request.resource.data))
        || (purging(w) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletingBy'])
          && !('deletingBy' in request.resource.data))
        || (purging(w) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerID','deletingBy','inviteToken'])
          && request.resource.data.ownerID is string && request.resource.data.ownerID != request.auth.uid
          && !('deletingBy' in request.resource.data) && !('inviteToken' in request.resource.data)
          && exists(/databases/$(database)/documents/workspaces/$(w)/members/$(request.resource.data.ownerID))
          && getAfter(/databases/$(database)/documents/workspaces/$(w)/members/$(request.resource.data.ownerID)).data.role == 'owner'
          && !existsAfter(memberPath(w)) && !existsAfter(userPath())));
      allow delete: if purging(w) && !existsAfter(memberPath(w)) && !existsAfter(userPath());
      match /members/{uid} {
        allow read: if member(w);
        allow delete: if signedIn() && request.auth.uid == uid && recentLogin() && !existsAfter(userPath())
          && (get(workspacePath(w)).data.ownerID != uid || !existsAfter(workspacePath(w))
            || getAfter(workspacePath(w)).data.ownerID != uid);
        allow update: if (canWrite(w) && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && text(request.resource.data.displayName,160))
          || (purging(w) && uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role == 'owner'
            && getAfter(workspacePath(w)).data.ownerID == uid
            && !existsAfter(memberPath(w)) && !existsAfter(userPath()));
        allow create: if signedIn() && uid == request.auth.uid && unassigned()
          && getAfter(userPath()).data.workspaceID == w
          && validIdentity(request.resource.data)
          && ((request.resource.data.keys().hasOnly(['role', 'displayName'])
               && request.resource.data.role == 'owner'
               && getAfter(workspacePath(w)).data.ownerID == request.auth.uid)
            || (request.resource.data.keys().hasOnly(['role', 'inviteToken', 'displayName'])
               && request.resource.data.role == 'member'
               && validInvite(w, request.resource.data.inviteToken)));
      }
      match /lists/{list} {
        allow read: if member(w);
        allow create: if signedIn() && accountActive() && existsAfter(memberPath(w))
          && (!exists(workspacePath(w)) || unlocked(w))
          && request.resource.data.keys().hasOnly(['name','lastChangedAt']) && text(request.resource.data.name, 80)
          && (!('lastChangedAt' in request.resource.data) || request.resource.data.lastChangedAt == request.time);
        allow delete: if purging(w);
        allow update: if canWrite(w)
          && request.resource.data.keys().hasOnly(['name','lastChangedAt']) && text(request.resource.data.name, 80)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastChangedAt']) || request.resource.data.lastChangedAt == request.time);
        match /items/{item} {
          allow read: if member(w);
          allow delete: if canWrite(w) || purging(w);
          function validItem() { return canWrite(w)
            && exists(/databases/$(database)/documents/workspaces/$(w)/lists/$(list))
            && request.resource.data.keys().hasOnly(['name', 'quantity', 'checked', 'category', 'createdAt', 'checkedAt', 'lastActorUID', 'lastActionAt'])
            && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
            && (!('checkedAt' in request.resource.data) || request.resource.data.checkedAt == null || request.resource.data.checkedAt is timestamp)
            && validCategory(request.resource.data)
            && text(request.resource.data.name, 120)
            && request.resource.data.quantity is string && request.resource.data.quantity.size() <= 80
            && request.resource.data.checked is bool; }
          function validActor() { return (!('lastActorUID' in request.resource.data) && !('lastActionAt' in request.resource.data))
            || (request.resource.data.lastActorUID == request.auth.uid && request.resource.data.lastActionAt == request.time); }
          allow create: if validItem() && validActor()
            && request.resource.data.createdAt == request.time
            && request.resource.data.checked == false && request.resource.data.checkedAt == null;
          allow update: if (validItem()
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastActorUID','lastActionAt']) || (request.resource.data.lastActorUID == request.auth.uid && request.resource.data.lastActionAt == request.time))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
            && ((request.resource.data.checked == true && resource.data.checked == false
                 && request.resource.data.checkedAt == request.time)
              || (!(request.resource.data.checked == true && resource.data.checked == false)
                 && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checkedAt']))))
            || (member(w) && recentLogin() && resource.data.get('lastActorUID','') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActorUID','lastActionAt'])
              && !('lastActorUID' in request.resource.data) && !('lastActionAt' in request.resource.data));
        }
      }
      match /products/{product} {
        allow read: if member(w);
        allow delete: if purging(w);
        allow create, update: if canWrite(w) && request.resource.data.keys().hasOnly(['name', 'category'])
          && validCategory(request.resource.data)
          && text(request.resource.data.name, 120);
      }
    }
    match /invites/{token} {
      allow get: if signedIn() && resource.data.expiresAt > request.time
        && get(workspacePath(resource.data.workspaceID)).data.inviteToken == token;
      allow create: if signedIn() && owner(request.resource.data.workspaceID) && accountActive() && unlocked(request.resource.data.workspaceID)
        && token.matches('^[a-f0-9-]{72}$')
        && request.resource.data.keys().hasOnly(['workspaceID', 'name', 'expiresAt'])
        && request.resource.data.name == get(workspacePath(request.resource.data.workspaceID)).data.name
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && getAfter(workspacePath(request.resource.data.workspaceID)).data.inviteToken == token;
      allow delete: if owner(resource.data.workspaceID);
    }
  }
}
